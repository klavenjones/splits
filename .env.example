# Copy to .env and fill in. Never commit .env.

# Supabase project (Project Settings → API). The anon key is safe in the app; RLS protects the data.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Used only by `npm run db:types` (not bundled into the app).
SUPABASE_PROJECT_ID=your-project-ref

# Later build steps
# USDA_API_KEY=
# SENTRY_DSN=
