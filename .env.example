# Copy to .env and fill in. Never commit .env.

# Supabase project (Project Settings → API). The anon key is safe in the app; RLS protects the data.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Used only by `npm run db:types` (not bundled into the app).
SUPABASE_PROJECT_ID=your-project-ref

# Food search (step 8): set as a Supabase Edge Function secret, never bundled into the app.
# USDA_API_KEY=

# Error reporting (step 9). The DSN is bundled into the app (it's public by design).
EXPO_PUBLIC_SENTRY_DSN=
# Send from a dev build too (normally only release builds send). Leave unset.
# EXPO_PUBLIC_SENTRY_DEV=1

# Source map and dSYM upload for Release builds (never bundled). An org auth token with
# project:releases and org:read. A Release build fails without it unless
# SENTRY_DISABLE_AUTO_UPLOAD=true.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=your-sentry-org-slug
SENTRY_PROJECT=splits
