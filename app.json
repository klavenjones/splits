{
  "expo": {
    "name": "splits",
    "slug": "splits",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "splits",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.klavenjones.splits",
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "./plugins/withoutPushEntitlement",
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-sqlite",
      "expo-video",
      "expo-dev-client",
      [
        "@kingstinct/react-native-healthkit",
        {
          "NSHealthShareUsageDescription": "Splits reads your runs, heart rate and weight from Apple Health to log your training and weigh-ins.",
          "NSHealthUpdateUsageDescription": "Splits only writes sample runs in development builds.",
          "background": true
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Splits scans food barcodes.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      "@sentry/react-native",
      "./plugins/withSentryDebugSkip"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "url": "https://u.expo.dev/af761fa9-94e8-460b-a625-e0bfaee7f232"
    },
    "extra": {
      "eas": {
        "projectId": "af761fa9-94e8-460b-a625-e0bfaee7f232"
      }
    },
    "owner": "klaven"
  }
}
